<!-- In-game overlay; DataContext is OverlayViewModel. -->
<Window x:Class="PcPulse.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Pulse Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Left="16" Top="16"
        FontFamily="{StaticResource MonoFont}">
    <Border CornerRadius="10" Background="#C80B0F17" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,8,14,8">
        <Grid>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#E6EAF2"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,1,10,1"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="52"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="FPS" Foreground="#B47CFF" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="{Binding FpsText}" FontSize="18" FontWeight="Bold">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{Binding FpsColor}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Grid.Column="2" Text="{Binding FrameText}" Foreground="#7C869A" FontSize="12"/>

            <TextBlock Grid.Row="1" Text="CPU" Foreground="#4DC9FF" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuTempText}">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{Binding CpuTempColor}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CpuLoadText}"/>

            <TextBlock Grid.Row="2" Text="GPU" Foreground="#76E06A" FontWeight="Bold"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GpuTempText}">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{Binding GpuTempColor}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GpuLoadText}"/>
        </Grid>
    </Border>
</Window>
