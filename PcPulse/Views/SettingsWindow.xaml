<!-- Settings dialog; DataContext is SettingsViewModel. -->
<Window x:Class="PcPulse.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PcPulse.Controls"
        Title="Настройки — PC Pulse" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        Icon="pack://application:,,,/Assets/PcPulse.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <StackPanel Margin="24,0,24,22">
            <Grid Height="52">
                <TextBlock Text="Настройки" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Content="✕" Style="{StaticResource ChromeButton}" HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="16,10">
                <StackPanel>
                    <Grid Margin="0,6">
                        <TextBlock Text="Показать / скрыть оверлей" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <c:HotkeyBox Hotkey="{Binding OverlayHotkey}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <TextBlock Text="Показать / скрыть окно" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <c:HotkeyBox Hotkey="{Binding WindowHotkey}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="Кликните поле и нажмите комбинацию. Backspace — отключить, Esc — отмена."
                               Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,4"/>
                </StackPanel>
            </Border>

            <TextBlock Text="ОВЕРЛЕЙ" Style="{StaticResource SectionTitle}"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="16,12">
                <Grid>
                    <TextBlock Text="Положение на экране" Foreground="{StaticResource TextBrush}" FontSize="13"
                               VerticalAlignment="Center"/>
                    <UniformGrid Columns="2" HorizontalAlignment="Right">
                        <RadioButton GroupName="Corner" Content="↖ слева" Style="{StaticResource PillToggle}" Margin="3"
                                     IsChecked="{Binding Corner, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft}"/>
                        <RadioButton GroupName="Corner" Content="↗ справа" Style="{StaticResource PillToggle}" Margin="3"
                                     IsChecked="{Binding Corner, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight}"/>
                        <RadioButton GroupName="Corner" Content="↙ слева" Style="{StaticResource PillToggle}" Margin="3"
                                     IsChecked="{Binding Corner, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft}"/>
                        <RadioButton GroupName="Corner" Content="↘ справа" Style="{StaticResource PillToggle}" Margin="3"
                                     IsChecked="{Binding Corner, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight}"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <TextBlock Text="ТРЕЙ" Style="{StaticResource SectionTitle}"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="16,8">
                <StackPanel>
                    <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Сворачивать в трей" Style="{StaticResource Switch}"/>
                    <CheckBox IsChecked="{Binding CloseToTray}" Content="Кнопка ✕ сворачивает в трей, а не закрывает" Style="{StaticResource Switch}"/>
                    <CheckBox IsChecked="{Binding StartInTray}" Content="Запускать свёрнутым в трей" Style="{StaticResource Switch}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                       Foreground="#FF4D6D" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Style="{StaticResource ActionButton}" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                <Button Content="Сохранить" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
