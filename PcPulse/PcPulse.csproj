<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF front end and composition root. Logic lives in PcPulse.Core, Windows plumbing in PcPulse.Infrastructure. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray NotifyIcon; its namespaces are kept out of the global usings below. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms wants DPI set in code; for this WPF app the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PcPulse.ico</ApplicationIcon>
    <AssemblyName>PcPulse</AssemblyName>
    <RootNamespace>PcPulse</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PcPulse.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcPulse.Core\PcPulse.Core.csproj" />
    <ProjectReference Include="..\PcPulse.Infrastructure\PcPulse.Infrastructure.csproj" />
  </ItemGroup>

</Project>
