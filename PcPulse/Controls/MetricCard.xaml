<!-- Dashboard card; DataContext is a MetricCardViewModel. -->
<UserControl x:Class="PcPulse.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcPulse.Controls">
    <Border CornerRadius="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1" Padding="20,18" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding Accent}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Margin="16,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Grid Grid.Row="1" Width="168" Height="168" Margin="0,14,0,6" HorizontalAlignment="Center">
                <local:RingGauge Thickness="11" Target="{Binding GaugeValue}" Maximum="{Binding GaugeMaximum}"
                                 Color="{Binding GaugeColor}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding MainText}" FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Hint}" Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"
                           TextWrapping="Wrap" FontSize="11.5" Foreground="#FFC857" Margin="0,8,0,0"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,14,0,0" MinHeight="54">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding HistoryLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <local:Sparkline Grid.Row="1" Values="{Binding History}" MinScale="{Binding History.MinScale}"
                                 Capacity="60" Color="{Binding Accent}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
